# Vorlage: kopieren nach .env.local und Key eintragen (.env.local wird nie committet)

# Kostenloser Key aus Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelle (optional, Standardwerte siehe src/lib/server/env.ts)
GEMINI_LIVE_MODEL=gemini-3.8-live

# Master-Code: gilt fuer immer und oeffnet die Verwaltung (/admin).
# Lokal leer lassen = kein Schutz. In Produktion Pflicht.
MASTER_CODE=

# Neon-Postgres fuer persoenliche Zugangscodes (Datenbank-eintragen.cmd)
DATABASE_URL=

# Bewertung: Reihenfolge = Priorität, bei Überlastung wird das nächste Modell genommen
GEMINI_EVAL_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
